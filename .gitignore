smoke_test_result.txt
*.log

# Unity 6 solution file (like *.sln, IDE-generated)
*.slnx

# Python bytecode
__pycache__/
*.pyc

# Secrets (API keys) - never commit
.env

# Local voice command recording
/tools/utterance.wav
